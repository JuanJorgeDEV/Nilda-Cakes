# URL base da API interna do .NET (Program.cs / WhatsAppBotEndpoints).
# Ex.: http://localhost:5138
API_BASE_URL=http://localhost:5138

# Mesmo valor configurado em InternalApi:WhatsAppBotKey
# (appsettings.Development.json ou variavel de ambiente/user-secrets em producao).
API_KEY=troque-para-a-chave-configurada-no-backend

# Intervalo (ms) opcional entre verificacoes periodicas de status do bot.
# Usado apenas para log/telemetria local; a checagem de status por conversa
# acontece a cada mensagem recebida, independente deste valor.
POLL_INTERVAL_MS=60000
