@page
@using DeliciasDaNilda.Services
@using DeliciasDaNilda.Services.Common
@model DeliciasDaNilda.Pages.Admin.Sabores.CadastroModel
@{
    ViewData["Title"] = "Cardápio";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Cardápio</h1>
    <a asp-page="/Admin/Sabores/Editar" class="btn btn-primary btn-sm">+ Novo sabor</a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.MensagemSucesso))
{
    <div class="alert alert-success py-2">@Model.MensagemSucesso</div>
}
@if (!string.IsNullOrWhiteSpace(Model.MensagemErro))
{
    <div class="alert alert-danger py-2">@Model.MensagemErro</div>
}

@if (Model.Sabores.Count == 0)
{
    <div class="dn-card p-4 text-center" style="color:var(--ink-soft);">Nenhum sabor cadastrado ainda.</div>
}

<div class="dn-sabores">
    @foreach (var sabor in Model.Sabores)
    {
        var custo = SaborService.CalcularCustoPorKg(sabor);
        var incompleto = SaborService.CustoIncompleto(sabor);
        var margem = sabor.PrecoPorKg > 0 ? (sabor.PrecoPorKg - custo) / sabor.PrecoPorKg : 0m;
        var itens = sabor.FichaTecnica?.Itens.OrderByDescending(i => i.QuantidadePorKg).ToList() ?? new();
        <article class="dn-sabor @(sabor.Disponivel ? "" : "pausado")">
            <div class="dn-sabor-foto @(string.IsNullOrWhiteSpace(sabor.ImagemUrl) ? "sem-foto" : "")">
                @if (!string.IsNullOrWhiteSpace(sabor.ImagemUrl))
                {
                    <img src="@sabor.ImagemUrl" alt="@sabor.Nome" loading="lazy" />
                }
                else
                {
                    <span class="dn-sabor-inicial" aria-hidden="true">@sabor.Nome[0]</span>
                }
                <span class="dn-badge @(sabor.Disponivel ? "dn-badge-confirmado" : "dn-badge-cancelado")">@(sabor.Disponivel ? "Disponível" : "Pausado")</span>
            </div>
            <div class="dn-sabor-corpo">
                <h2 class="dn-sabor-nome">@sabor.Nome</h2>
                @if (!string.IsNullOrWhiteSpace(sabor.Descricao))
                {
                    <p class="dn-sabor-desc">@sabor.Descricao</p>
                }

                <dl class="dn-sabor-numeros">
                    <div><dt>Preço</dt><dd>@sabor.PrecoPorKg.ToString("C")<small>/kg</small></dd></div>
                    <div>
                        <dt>Custo@(incompleto ? "*" : "")</dt>
                        <dd>@(custo > 0 ? custo.ToString("C") : "—")<small>/kg</small></dd>
                    </div>
                    <div>
                        <dt>Margem</dt>
                        <dd class="@(custo > 0 ? (margem >= 0.5m ? "dn-stat-ok" : margem >= 0.3m ? "dn-stat-warn" : "dn-stat-danger") : "")">
                            @(custo > 0 ? margem.ToString("P0") : "—")
                        </dd>
                    </div>
                </dl>
                @if (incompleto)
                {
                    <p class="dn-sabor-nota">* Algum ingrediente está sem custo. <a asp-page="/Admin/Insumos/Index">Cadastrar custos</a></p>
                }

                <details class="dn-sabor-ficha">
                    <summary>Ficha técnica · @itens.Count @(itens.Count == 1 ? "ingrediente" : "ingredientes") por kg</summary>
                    <ul class="dn-ficha-lista">
                        @foreach (var item in itens)
                        {
                            <li>
                                <span>@item.Ingrediente.Nome</span>
                                <span class="dn-ficha-qtd-txt">@QuantidadeFormatter.Formatar(item.QuantidadePorKg, item.Ingrediente.UnidadeMedida)</span>
                            </li>
                        }
                    </ul>
                </details>

                <div class="dn-sabor-acoes">
                    <a asp-page="/Admin/Sabores/Editar" asp-route-id="@sabor.Id" class="btn btn-outline-primary btn-sm">Editar</a>
                    <form method="post" asp-page-handler="Alternar" asp-route-id="@sabor.Id">
                        <button type="submit" class="btn btn-outline-secondary btn-sm" data-confirmar="@(sabor.Disponivel ? "Pausar" : "Ativar") o sabor @sabor.Nome? @(sabor.Disponivel ? "Ele deixa de aparecer para os clientes." : "Ele volta a aparecer para os clientes.")">@(sabor.Disponivel ? "Pausar" : "Ativar")</button>
                    </form>
                    <form method="post" asp-page-handler="Excluir" asp-route-id="@sabor.Id" class="ms-auto"
                          onsubmit="return confirm('Excluir o sabor @sabor.Nome.Replace("'", "") do cardápio? Os pedidos antigos continuam com ele.');">
                        <button type="submit" class="btn btn-outline-danger btn-sm">Excluir</button>
                    </form>
                </div>
            </div>
        </article>
    }
</div>
