@page
@model DeliciasDaNilda.Pages.Admin.Pedidos.IndexModel
@{
    ViewData["Title"] = "Pedidos";
    var voltar = $"{Request.Path}{Request.QueryString}";
    var filtros = new (string Id, string Rotulo)[]
    {
        ("ativos", "A entregar"),
        ("pendentes", "A confirmar"),
        ("semana", "Próximos 7 dias"),
        ("entregues", "Entregues"),
        ("cancelados", "Cancelados"),
        ("todos", "Todos"),
    };
    var totalFaltas = Model.Faltas.Count;
}

<h1 class="h4 mb-3">Pedidos</h1>

@if (!string.IsNullOrWhiteSpace(Model.MensagemSucesso))
{
    <div class="alert alert-success py-2">@Model.MensagemSucesso</div>
}
@if (!string.IsNullOrWhiteSpace(Model.MensagemErro))
{
    <div class="alert alert-danger py-2">@Model.MensagemErro</div>
}

<nav class="dn-chips mb-3" aria-label="Filtrar pedidos">
    @foreach (var filtro in filtros)
    {
        var ativo = Model.Filtro == filtro.Id || (filtro.Id == "ativos" && !filtros.Any(x => x.Id == Model.Filtro));
        <a asp-page="/Admin/Pedidos/Index" asp-route-f="@filtro.Id" class="dn-chip @(ativo ? "ativo" : "")">
            @filtro.Rotulo
            @if (filtro.Id == "pendentes" && Model.Contagens.GetValueOrDefault("pendentes") > 0)
            {
                <span class="dn-chip-contador">@Model.Contagens["pendentes"]</span>
            }
        </a>
    }
</nav>

@if (totalFaltas > 0)
{
    <div class="dn-aviso-falta mb-3">
        ⚠ @(totalFaltas == 1 ? "1 pedido a confirmar não tem" : $"{totalFaltas} pedidos a confirmar não têm") ingrediente suficiente no estoque.
        <a asp-page="/Admin/Estoque/Alertas">Ver o que comprar</a>
    </div>
}

@if (Model.Pedidos.Count == 0)
{
    <div class="dn-card p-4 text-center" style="color:var(--ink-soft);">Nenhum pedido aqui.</div>
}

<div class="d-flex flex-column gap-2">
    @foreach (var pedido in Model.Pedidos)
    {
        <partial name="_PedidoCard" model="new PedidoCardModel(pedido, Model.Faltas.GetValueOrDefault(pedido.Id), Model.Hoje, voltar, Model.Aberto == pedido.Id)" />
    }
</div>

@section Scripts {
    <script>
        // Depois de uma ação, rola até o card que ficou aberto.
        document.querySelector('.dn-pedido .collapse.show')?.closest('.dn-pedido')?.scrollIntoView({ block: 'start' });
    </script>
}
