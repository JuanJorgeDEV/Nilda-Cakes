@page
@model DeliciasDaNilda.Pages.Admin.Estoque.AlertasModel
@{
    ViewData["Title"] = "Alerta de reposição";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Alerta de reposição de estoque</h1>
    <a asp-page="/Admin/Index" class="btn btn-outline-secondary btn-sm">Voltar ao painel</a>
</div>

@if (Model.Resultado is not null)
{
    if (Model.Resultado.EstoqueSuficiente)
    {
        <div style="background:#EAF5EC;border:1.5px solid #A9D3B4;border-radius:16px;padding:26px 24px;text-align:center;">
            <div class="dn-shape-circle dn-shape-check-bg dn-shape-check-ok mb-3" style="width:44px;height:44px;">
                <div class="dn-shape-check-bar-short"></div>
                <div class="dn-shape-check-bar-long"></div>
            </div>
            <div style="font-weight:700;font-size:16px;color:#2E5F3D;margin-bottom:4px;">Tudo certo por aqui!</div>
            <div style="font-size:13px;color:#2E5F3D;">
                O estoque atual dá para todos os pedidos que estão aguardando a sua confirmação.
            </div>
        </div>
    }
    else
    {
        var alerta = Model.Resultado.Alerta!;
        <div style="background:#FCEAE8;border:1.5px solid #E6A29B;border-radius:16px;padding:22px 24px;">
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="dn-shape-alert-bg">
                    <div class="bar"></div>
                    <div class="dot"></div>
                </div>
                <div>
                    <div style="font-weight:700;font-size:16px;color:#8A2E29;">Faltará ingrediente para um pedido aguardando confirmação</div>
                    <div style="font-size:12.5px;color:#8A2E29;">O estoque de hoje atende os pedidos pendentes até o anterior a este. Se for confirmar o pedido abaixo, providencie a compra até a data limite.</div>
                </div>
            </div>
            <div class="dn-alert-quadro">
                <div>
                    <div class="dn-alert-item-label">Ingrediente</div>
                    <div class="dn-alert-item-valor">@alerta.IngredienteNome</div>
                </div>
                <div>
                    <div class="dn-alert-item-label">Quanto comprar</div>
                    <div class="dn-alert-item-valor">@alerta.QuantidadeFaltante.ToString("N4") @alerta.UnidadeMedida</div>
                </div>
                <div>
                    <div class="dn-alert-item-label">Pedido afetado</div>
                    <div class="dn-alert-item-valor">#@alerta.PedidoAfetadoId — entrega @alerta.DataEntregaPedidoAfetado.ToString("dd/MM/yyyy")</div>
                </div>
                <div>
                    <div class="dn-alert-item-label">Comprar até</div>
                    <div class="dn-alert-item-valor" style="color:#B0433F;">@alerta.DataLimiteCompra.ToString("dd/MM/yyyy")</div>
                </div>
            </div>
        </div>
        <a asp-page="/Admin/Insumos/Index" class="btn btn-primary btn-sm mt-3">Registrar entrada de insumo</a>
    }
}
