@page
@model DeliciasDaNilda.Pages.Admin.LoginModel
@{
    ViewData["Title"] = "Login ADM";
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login ADM - Delícias da Nilda</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Yellowtail&family=Playfair+Display:ital,wght@0,600;0,700;1,600&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
</head>
<body class="dn-login-shell">
    <div class="dn-login-card">
        <img src="~/images/logo.jpeg" alt="Delícias da Nilda" />
        <h1 class="h5 mb-1">Painel da Nilda</h1>
        <p style="font-size:13px;color:var(--ink-soft);">Acesso restrito à administração</p>

        <form method="post" class="dn-login-form">
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Entrada.Email" class="form-label"></label>
                <input asp-for="Entrada.Email" class="form-control" required />
                <span asp-validation-for="Entrada.Email" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Entrada.Senha" class="form-label"></label>
                <input asp-for="Entrada.Senha" type="password" class="form-control" required />
                <span asp-validation-for="Entrada.Senha" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 btn-lg">Entrar</button>
        </form>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
