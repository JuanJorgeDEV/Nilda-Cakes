@page
@using DeliciasDaNilda.Domain.Enums
@model DeliciasDaNilda.Pages.Admin.Pagamentos.RegistrarModel
@{
    ViewData["Title"] = "Pagamentos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Registrar pagamento</h1>
    <a asp-page="/Admin/Pedidos/Index" class="btn btn-outline-secondary btn-sm">Voltar aos pedidos</a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.MensagemSucesso))
{
    <div class="alert alert-success">@Model.MensagemSucesso</div>
}
@if (!string.IsNullOrWhiteSpace(Model.MensagemErro))
{
    <div class="alert alert-danger">@Model.MensagemErro</div>
}

<div class="dn-card p-3" style="max-width:520px;">
    <form method="post">
        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Entrada.PedidoId" class="form-label">Pedido em aberto</label>
            <select asp-for="Entrada.PedidoId" class="form-select" required
                    onchange="if (this.value) location.href='?pedidoId=' + this.value">
                <option value="">Selecione um pedido</option>
                @foreach (var pedido in Model.PedidosEmAberto)
                {
                    <option value="@pedido.Id" selected="@(pedido.Id == Model.PedidoId)">
                        @pedido.Cliente.NomeCompleto — @pedido.Sabor.Nome — @pedido.ValorTotal.ToString("C")
                    </option>
                }
            </select>
        </div>

        @if (Model.PedidoSelecionado is not null)
        {
            var pedidoSel = Model.PedidoSelecionado;
            <div class="dn-resumo mb-3">
                <div class="dn-resumo-linha"><span>Valor total</span><strong>@pedidoSel.ValorTotal.ToString("C")</strong></div>
                @if (Model.ApenasSaldo)
                {
                    <div class="dn-resumo-linha"><span>Já pago</span><strong style="color:var(--ok);">@Model.JaPago.ToString("C")</strong></div>
                    <div class="dn-resumo-linha"><span>Saldo restante</span><strong style="color:var(--wine);font-size:15px;">@Model.Restante.ToString("C")</strong></div>
                }
            </div>

            @if (Model.Restante <= 0)
            {
                <p class="mb-0" style="color:var(--ink-soft);">Este pedido já está quitado.</p>
            }
            else
            {
                @if (Model.ApenasSaldo)
                {
                    <p class="mb-3" style="color:var(--ink-soft);">Sinal já recebido. Falta acertar o saldo restante.</p>
                }
                else
                {
                    <div class="mb-3">
                        <div class="form-label">Tipo de pagamento</div>
                        <div class="d-flex gap-3 flex-wrap">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="Entrada.Tipo" id="tipo-integral" value="@((int)TipoPagamento.Integral)" checked />
                                <label class="form-check-label" for="tipo-integral">Integral (@pedidoSel.ValorTotal.ToString("C"))</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="Entrada.Tipo" id="tipo-sinal" value="@((int)TipoPagamento.Sinal)" />
                                <label class="form-check-label" for="tipo-sinal">Sinal (parte do valor)</label>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3" id="campo-valor" hidden>
                        <label asp-for="Entrada.Valor" class="form-label">Valor do sinal (R$)</label>
                        <input asp-for="Entrada.Valor" type="number" step="0.01" min="0.01" max="@pedidoSel.ValorTotal" class="form-control" placeholder="Ex: 50,00" />
                    </div>
                }

                <div class="mb-4">
                    <label asp-for="Entrada.FormaPagamento" class="form-label"></label>
                    <input asp-for="Entrada.FormaPagamento" class="form-control" placeholder="Dinheiro, Pix, Cartão..." />
                </div>

                <button type="submit" class="btn btn-primary w-100">
                    @(Model.ApenasSaldo ? $"Receber saldo de {Model.Restante:C}" : "Registrar pagamento")
                </button>
            }
        }
    </form>
</div>

@section Scripts {
    <script>
        (function () {
            var sinal = document.getElementById('tipo-sinal');
            var campo = document.getElementById('campo-valor');
            if (!sinal || !campo) return;
            var valor = campo.querySelector('input');
            function atualizar() {
                campo.hidden = !sinal.checked;
                valor.required = sinal.checked;
                if (!sinal.checked) valor.value = '';
            }
            document.querySelectorAll('input[name="Entrada.Tipo"]').forEach(function (r) {
                r.addEventListener('change', atualizar);
            });
            atualizar();
        })();
    </script>
}
