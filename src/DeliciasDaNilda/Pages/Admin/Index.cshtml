@page
@using DeliciasDaNilda.Domain.Enums
@model DeliciasDaNilda.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Hoje";
    string Plural(int n, string singular, string plural) => n == 1 ? $"1 {singular}" : $"{n} {plural}";
    var hoje = DateOnly.FromDateTime(DateTime.Today);
    var cultura = new System.Globalization.CultureInfo("pt-BR");
}

<h1 class="h4 mb-3">Como está a loja hoje?</h1>

<div class="dn-panel-grid mb-4">
    <a asp-page="/Admin/Pedidos/Index" class="dn-panel-card">
        <div class="dn-panel-card-icon" style="background:var(--rose-light);"><partial name="_Icone" model="@("pedidos")" /></div>
        <div class="dn-panel-card-title">Pedidos</div>
        <div class="dn-panel-card-stat @(Model.PedidosPendentes > 0 ? "dn-stat-warn" : "")">
            @(Model.PedidosPendentes > 0 ? $"{Model.PedidosPendentes} aguardando confirmação" : "Nada pendente")
        </div>
    </a>
    <a asp-page="/Admin/Agenda/Index" class="dn-panel-card">
        <div class="dn-panel-card-icon" style="background:var(--rose-light);"><partial name="_Icone" model="@("agenda")" /></div>
        <div class="dn-panel-card-title">Entregas hoje</div>
        <div class="dn-panel-card-stat">@(Model.PedidosHoje == 0 ? "Nenhuma" : Plural(Model.PedidosHoje, "entrega", "entregas"))</div>
    </a>
    <a asp-page="/Admin/Estoque/Alertas" class="dn-panel-card">
        <div class="dn-panel-card-icon" style="background:var(--danger-bg);"><partial name="_Icone" model="@("alerta")" /></div>
        <div class="dn-panel-card-title">Estoque</div>
        @if (Model.IngredienteEmFalta is not null)
        {
            <div class="dn-panel-card-stat dn-stat-danger">Vai faltar: @Model.IngredienteEmFalta</div>
        }
        else
        {
            <div class="dn-panel-card-stat dn-stat-ok">Estoque em dia</div>
        }
    </a>
    <a asp-page="/Admin/Financeiro/Index" class="dn-panel-card">
        <div class="dn-panel-card-icon" style="background:var(--gold-light);"><partial name="_Icone" model="@("pagamento")" /></div>
        <div class="dn-panel-card-title">A receber</div>
        <div class="dn-panel-card-stat">@(Model.ValorAReceber > 0 ? Model.ValorAReceber.ToString("C") : "Tudo recebido")</div>
    </a>
</div>

<div class="d-flex justify-content-between align-items-baseline mb-2">
    <h2 class="h6 mb-0 dn-secao-titulo">Próximas entregas</h2>
    <a asp-page="/Admin/Agenda/Index" class="btn btn-outline-primary btn-sm">Ver agenda</a>
</div>
@if (Model.ProximasEntregas.Count == 0)
{
    <div class="dn-card p-3" style="color:var(--ink-soft);">Nenhuma entrega agendada.</div>
}
else
{
    <div class="d-flex flex-column gap-2 mb-4">
        @foreach (var p in Model.ProximasEntregas)
        {
            var dias = p.DataEntrega.DayNumber - hoje.DayNumber;
            var quando = dias switch { 0 => "HOJE", 1 => "amanhã", _ => $"em {dias} dias" };
            var badge = DeliciasDaNilda.Pages.Shared.StatusBadgeHelper.Pedido(p.StatusPedido);
            <a asp-page="/Admin/Pedidos/Index" asp-route-aberto="@p.Id" class="dn-entrega">
                <span class="dn-data-bloco @(dias == 0 ? "hoje" : "")">
                    <span class="dn-data-sem">@p.DataEntrega.ToString("ddd", cultura).TrimEnd('.')</span>
                    <span class="dn-data-dia">@p.DataEntrega.Day</span>
                    <span class="dn-data-mes">@p.DataEntrega.ToString("MMM", cultura).TrimEnd('.')</span>
                </span>
                <span class="dn-entrega-info">
                    <span class="dn-entrega-quando @(dias == 0 ? "hoje" : "")">@quando@(p.HorarioRetirada is { } h ? $" · {h:HH\\:mm}" : "")</span>
                    <span class="dn-pedido-cliente">@p.Cliente.NomeCompleto</span>
                    <span class="dn-pedido-sub">@p.Sabor.Nome · @p.Peso.ToString("0.##") kg</span>
                    <span class="dn-badge @badge.CssClass mt-1 align-self-start">● @badge.Label</span>
                </span>
            </a>
        }
    </div>
}

<div class="d-flex flex-wrap gap-2">
    <a asp-page="/Admin/Sabores/Cadastro" class="dn-atalho"><partial name="_Icone" model="@("cardapio")" /> @Plural(Model.SaboresDisponiveis, "sabor disponível", "sabores disponíveis")</a>
    <a asp-page="/Admin/Insumos/Index" class="dn-atalho"><partial name="_Icone" model="@("estoque")" /> @Plural(Model.Ingredientes, "ingrediente", "ingredientes")</a>
    <a asp-page="/Admin/WhatsAppBot/Index" class="dn-atalho"><partial name="_Icone" model="@("whatsapp")" /> Bot @(Model.BotAtivo ? "ligado" : "desligado")</a>
</div>
