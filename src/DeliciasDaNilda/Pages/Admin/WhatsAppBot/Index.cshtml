@page
@model DeliciasDaNilda.Pages.Admin.WhatsAppBot.IndexModel
@{
    ViewData["Title"] = "Atendimento automático";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Atendimento automático pelo WhatsApp</h1>
    <a asp-page="/Admin/Index" class="btn btn-outline-secondary btn-sm">Voltar ao painel</a>
</div>

<div class="dn-card p-3" style="max-width:560px;">
    <div class="d-flex align-items-center gap-2 mb-3">
        <span>Status atual:</span>
        @if (Model.BotAtivo)
        {
            <span class="dn-badge dn-badge-confirmado">Ativo</span>
        }
        else
        {
            <span class="dn-badge dn-badge-cancelado">Inativo</span>
        }
    </div>

    <p>
        Quando o atendimento automático está <strong>ativo</strong>, os clientes podem fazer pedidos
        conversando diretamente com o WhatsApp da loja, sem precisar da Nilda para anotar nada.
    </p>
    <p>
        Quando está <strong>inativo</strong>, o WhatsApp não cria pedidos sozinho — os clientes só
        conseguem fazer pedidos pelo site.
    </p>

    <form method="post" class="mt-3">
        @if (Model.BotAtivo)
        {
            <input type="hidden" name="ativar" value="false" />
            <button type="submit" class="btn btn-outline-danger">Desligar atendimento automático</button>
        }
        else
        {
            <input type="hidden" name="ativar" value="true" />
            <button type="submit" class="btn btn-primary">Ligar atendimento automático</button>
        }
    </form>
</div>
